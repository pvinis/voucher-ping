# Resend API key. Without it the scraper only logs a mock notification and the
# subscribe endpoint returns 503.
RESEND_API_KEY=X

# Resend audience contacts are added to and broadcasts are sent to.
RESEND_AUDIENCE_ID=1f918c14-b245-4b04-99c9-aa3b3ec8ed61

# Verified sender address. Must be on a domain verified in Resend.
RESEND_FROM_EMAIL=Voucher Ping <onboarding@resend.dev>

# Public site URL, linked from the notification email.
SITE_URL=https://voucher-ping.vercel.app

# Comma-separated CORS allowlist for the subscribe API.
ALLOWED_ORIGINS=http://localhost:3000

# Base URL of the deployed API, baked into the web build.
VITE_API_URL=http://localhost:3001
